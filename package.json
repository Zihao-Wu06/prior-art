{
  "name": "priorart",
  "version": "0.4.0",
  "description": "Search prior art before you build. An evidence engine that stops AI coding agents from reinventing the wheel.",
  "type": "module",
  "bin": {
    "priorart": "src/cli/index.js",
    "pa": "src/cli/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/benchmark-gate.js",
    "benchmark": "node scripts/benchmark.js",
    "benchmark:dry": "node scripts/benchmark.js --dry",
    "benchmark:gate": "node scripts/benchmark-gate.js",
    "index": "node scripts/wheel-index.js",
    "pr-review": "node src/action/cli.js"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "mcp",
    "dependencies",
    "software-supply-chain",
    "buy-vs-build",
    "prior-art",
    "agents-md"
  ],
  "author": "Zihao Wu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zihao-Wu06/prior-art"
  },
  "files": [
    "src",
    "scripts",
    "skills",
    "hooks",
    "rules",
    "knowledge",
    "action.yml",
    "benchmarks/behavior-cases.json",
    "docs/decisions/0000-template.md",
    "docs/README.zh-CN.md",
    "docs/wheel-reinvention-index.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
